# Machine-local overrides (untracked). Single-card 35B-A3B APEX on GPU1 (the headless
# x4 card — x4 is IRRELEVANT to single-GPU inference; it only slows the one-time weight load).

MODEL_DIR=/home/pawl/models

# Pin to GPU1 (headless), leave GPU0 for the Windows desktop.
CUDA_VISIBLE_DEVICES=1

# MTP OFF — A/B'd 2026-07-08 on THIS MoE (single-card, short-prompt decode probe):
#   off => ~84 TPS · n=2 => ~55 (accept 60%) · n=4 => ~65 (accept 40%). MTP LOSES at
#   every depth. Structural: a3b MoE has only ~3B active params, so base decode is
#   already cheap (~12ms/tok); the MTP head's extra forward pass costs more than the
#   ~1.6 tok/step it buys back. Same net-negative as vLLM. n_max=0 = no speculation.
MTP_DRAFT_N_MAX=0

# NP <-> CTX coupling (llama.cpp/ik semantics — NOT vLLM's):
#   --ctx-size is the TOTAL KV pool, carved into NP EQUAL, FIXED slots at boot.
#   Per-request cap = CTX_SIZE / NP, and it's HARD: a single request maxes at that
#   even if the other slots sit idle (no borrowing — the pool is pre-sliced, not shared).
#   The server prints "n_ctx_per_seq = n_ctx / n_parallel" and truncates prompts past it.
#     NP=3, CTX=196608 -> three fixed 65536 slots -> a 196K file would TRUNCATE at 65K.
#     NP=1, CTX=196608 -> the whole 196608 goes to one request. <- what we want.
#   (The "64K + others as long as the sum fits the total" shared-pool model is vLLM's
#    PagedAttention / max_num_seqs, NOT this engine. Use dual-vLLM for that behavior.)
#
# So NP=1 for BOTH reasons: (1) single-GPU fit — NP=3 needs 3x KV, won't fit 24GB
# alongside 17GB weights; (2) it hands the full window to one request. llama.cpp
# concurrency is poor anyway — use dual-vLLM max_num_seqs=4 for parallel subagents.
NP=1

# CTX 262144 = the model's FULL native trained window (n_ctx_train=262144); 196608 was
# below native. Measured fit on GPU1 (24 GB, headless): weights 16.2 GiB + KV @262K
# (q8_0 K+V) ~3.0 GiB + buffers — leaves ~3 GiB free. Spare VRAM does NOT raise decode
# TPS on a single fully-offloaded card (decode is bandwidth-bound); this buys capacity.
CTX_SIZE=262144

# -ub 1024 (compose default 512): larger microbatch speeds PREFILL / time-to-first-token
# on big prompts (large-repo file reads) — the one real use of the VRAM headroom for
# latency. Does not affect single-stream decode TPS. Costs a larger compute buffer.
UBATCH_SIZE=1024

# REASONING = the thinking gate (ik-llama's name for Qwen/vLLM "thinking"). Same mechanism:
# the model's <think> block. OFF (default) = direct answers, the snappy daily-driver mode —
# no per-turn reasoning monologue burning latency, output tokens, and the 262K window.
#   off  → thinking disabled (model emits an empty <think></think> and answers directly)
#   on   → thinking enabled; <think> is parsed into reasoning_content via REASONING_FORMAT
#          (deepseek). Worth it for hard multi-step debugging/reasoning; costs latency+tokens.
# To actually SEE it when on, also flip Hermes display.show_reasoning: true (it's false now).
# NOTE: Hermes' agent.reasoning_effort is DROPPED by LiteLLM (drop_params) — this env is the
# real lever for apex, not that Hermes setting.
REASONING=off
# REASONING_FORMAT=deepseek   # how <think> is routed when REASONING=on (compose default)

# PORT default 8056 → add a Hermes provider at http://localhost:8056/v1 to use it.
