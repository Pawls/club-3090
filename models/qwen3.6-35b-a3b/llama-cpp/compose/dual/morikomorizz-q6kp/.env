# Machine-local overrides for Qwen3.6-35B-A3B-Uncensored-HauhauCS ("hauhau").
# Uncensored MoE fine-tune (qwen3-next hybrid: 30 DeltaNet SSM + 10 full-attn, 256 experts),
# Q6_K_P ~30 GB GGUF, llama.cpp, DUAL-card layer-split. Needs BOTH 3090s (GPU-mutex: apex /
# omni / 35b-a3b / deckard must be DOWN first). The SSM layers keep KV compact, so full 262K
# fits (only the 10 full-attn layers carry growing KV) — total ~38 GB across both cards.

MODEL_DIR=/home/pawl/models

# Both cards required. Device 0 = desktop card (GPU0, ~1.7 GB busy on the monitors);
# device 1 = headless card (GPU1, fully free).
CUDA_VISIBLE_DEVICES=0,1

# --- Rig-specific split (differs from the compose default ON PURPOSE) --------------------
# Compose default is -ts 0.55,0.45, tuned for a HEADLESS dual rig: it puts the HEAVIER weight
# share (0.55) on device 0 to offset the MTP draft context, which pins to device 1 and grows
# with ctx. But on THIS box device 0 IS the desktop card — 0.55 there would stack ~19.7 GB of
# weights on top of the ~1.7 GB desktop (~21.4 GB, thin headroom for a browser/VS Code spike).
# So we flip the intent: EVEN split (0.5,0.5) lets the draft skew fall on the FREE headless
# GPU1 and keeps the desktop card the LIGHTER of the two (~19 GB on GPU0 incl. desktop / ~20.5
# GB on GPU1). If GPU0 still OOMs on a desktop spike, go 0.45,0.55; if GPU1 OOMs, go 0.55,0.45.
# VERIFY from the llama.cpp load log ("CUDA0/CUDA1 buffer size" + "KV self size") on first boot.
TENSOR_SPLIT=0.5,0.5

# Native 262K, validated to 240K NIAH. q8_0 KV. (Keep any Hermes context_length in sync.)
CTX_SIZE=262144
KV_TYPE=q8_0

# NP=1 mandatory on dual (compose warns: extra slots divide throughput + OOM the 262K spec buffer).
NP=1

# --- MTP (this build's spec-decode works on mainline b9570; lossless) --------------------
# n=3 = maintainer default, CODE-MAX: +10% code decode @262K but -9% PROSE vs n=1 (draft
# acceptance decays to ~50% on narrative). Since you code, n=3 fits — but if you notice prose
# quality dip, n=1 is prose-safe and n=2 balanced.
MTP_DRAFT_N_MAX=3

# --- Thinking / reasoning (hauhau ships thinking ON by maintainer choice) ----------------
# REASONING=on uses the model's full reasoning. REASONING_FORMAT=deepseek routes <think> into
# reasoning_content. To SEE it in Hermes, set display.show_reasoning: true (currently false).
#   =off  → stack-default non-thinking (faster); =auto → request-driven (client decides).
# ⚠ COST: reasoning here is heavy — the maintainer measured StructOutput ~57s/case and the
#   HermesAgent pack hitting the 300s ceiling. With reasoning ON, keep LiteLLM's timeout
#   generous (LCM_SUMMARY_TIMEOUT_MS etc. you already raised) or long tool-heavy turns can trip
#   the request timeout. If you hit spurious timeouts, set REASONING=off or =auto.
REASONING=on
REASONING_FORMAT=deepseek
# PRESERVE_THINKING — IS supported (corrected 2026-07-10): the compose now wires llama.cpp's
# --chat-template-kwargs. true = keep prior turns' <think> in context (matches your vLLM
# .envs); false = strip old thinking. At 262K there's lots of room, so true is comfortable
# here. (Verify the embedded template honors it on first boot: curl :8073/props and grep
# the chat_template for "preserve_thinking" — Deckard's did; this Qwen3.6 build should too.)
PRESERVE_THINKING=true

# Friendly served name → used by the LiteLLM route + Hermes provider (see config.yaml).
SERVED_NAME=hauhau-35b

# Anti-loop: compose defaults (1.1 / 256) are fine for this uncensored merge.
# REPEAT_PENALTY=1.1
# REPEAT_LAST_N=256

# Port 8073 (compose/registry default). NOTE: there is NO LiteLLM route for hauhau yet, so it
# won't appear in Hermes (which talks to LiteLLM :4000) until one is added — see the chat.
PORT=8073
