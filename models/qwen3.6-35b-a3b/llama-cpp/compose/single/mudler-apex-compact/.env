# Machine-local overrides (tracked on pawl-custom). Single-card APEX WITH VISION on
# mainline llama.cpp — the vision-capable sibling of the ik-llama apex (which can't
# do --mmproj). See vision.yml header for the full rationale + first-boot checklist.

MODEL_DIR=/home/pawl/models

# Pin to GPU1 (headless); leave GPU0 for the Windows desktop. x4 slot is irrelevant
# to single-GPU inference (only slows the one-time weight load).
CUDA_VISIBLE_DEVICES=1

# Trimmed from apex-ik's 262K to seat the ~0.86 GB mmproj vision tower + its image
# compute buffer alongside the 16.2 GB trunk. 200K is still enormous; raise toward
# 262144 only after confirming boot VRAM headroom with the mmproj loaded.
CTX_SIZE=200000

# K-high / V-low KV quant (Anbeeld pattern, docs/FAQ.md): K is the sensitive side.
# Frees ~0.4 GB vs q8_0/q8_0 to help the vision tower fit.
KV_TYPE_K=q8_0
KV_TYPE_V=q5_0

# Larger microbatch speeds prefill / TTFT on big prompts (image tokens + long text).
UBATCH_SIZE=1024

# Thinking OFF by default (snappy daily-driver mode), same as the ik apex. Flip to
# on for hard multi-step reasoning; auto = request-driven. PRESERVE_THINKING keeps
# prior turns' <think> in multi-turn context when reasoning is on.
REASONING=off
PRESERVE_THINKING=false

# Distinct served name + port so BOTH apexes can coexist in Hermes/LiteLLM (only one
# runs at a time under the GPU mutex, but both stay selectable):
#   apex-35b-compact = ik-llama, text-only, fastest MoE prefill (port 8056)
#   apex-35b-vision  = mainline, vision-capable, this compose      (port 8058)
SERVED_NAME=apex-35b-vision
PORT=8058
