# 35B-A3B (MoE) dual — machine-local overrides (untracked; docker compose auto-loads
# this file because switch.sh/launch.sh cd into this directory before `up`).

# WSL2 boot-crash workaround — the compose default `expandable_segments:True`
# crashes vLLM boot on WSL2 (PR #84 / issue #60). Must be False here.
#PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False,max_split_size_mb:512

# Weights live here on this host (repo-root models-cache doesn't exist).
MODEL_DIR=/home/pawl/models

# Serve on 8010 so Hermes (base_url http://localhost:8010) reaches it with only a
# model-name change (this compose's own default is 8051).
# PORT=8010

# Lowered from 0.92 to leave ~2.2 GB/card free for the Windows desktop + browser
# (YouTube NVDEC/compositing on card 0, the display card) while the model runs.
# KV pool stays >1.9x concurrency at 262K with max_num_seqs=2, so full context is intact.
# Claude chose 0.83, I'm trying 0.85
GPU_MEMORY_UTILIZATION=0.88

# Thinking ON — testing whether reasoning improves agentic comprehension vs the 27b.
ENABLE_THINKING=true

# Keep the <think> reasoning from ALL prior assistant turns in context (Qwen's
# preserve_thinking template kwarg). Default strips old thinking to save tokens;
# ON = the model sees its full past chain-of-thought. Costs context (thinking is
# verbose) and only takes effect if Hermes re-sends prior reasoning in history.
# NOW WIRED (2026-07-10): fp8.yml threads this into --default-chat-template-kwargs
# alongside enable_thinking, and the AutoRound weights' embedded chat_template.jinja
# implements preserve_thinking (verified on-disk — 2 refs, same as enable_thinking),
# so no template-patch mount is needed here (unlike the 27b's froggeric override).
# Previously this was set-but-dead (compose wired only enable_thinking).
# 2026-07-20: default flipped to false — a3b MoE thought-loop mitigation (see the apex
# .env note). NOTE: the litellm re-inline hook (custom_hooks.py QWEN_PRESERVE_MODELS) was
# ALSO dropping "qwen3.6-35b-a3b" the same day, else it would re-inject prior <think> into
# content and defeat this. --preserve re-enables per-boot.
PRESERVE_THINKING=false

# Concurrency A/B (2026-07-08): raise the MoE scheduler cap from 1 → 4. Does NOT grow
# the KV pool (mem_util fixes that) — just lets subagents / a second chat / Hermes aux
# tasks run in PARALLEL instead of queuing. Cheap hybrid KV (10 growing layers) has the
# headroom for short/moderate requests; 4 simultaneous FULL-262K prompts would still be
# KV-bound (pool ~1.9x), which vLLM handles by scheduling, not OOM.
MAX_NUM_SEQS=4