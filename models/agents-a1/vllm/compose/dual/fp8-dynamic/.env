# Machine-local overrides for Agents-A1 (InternScience 35B agentic MoE, FP8-dynamic, vLLM TP=2).
# Dual-card (both 3090s, GPU-mutex). Vision-capable. The agentic thinking-ON specialist.

MODEL_DIR=/home/pawl/models

# ⚠ WEIGHTS NOT DOWNLOADED YET (~36 GB). Before first boot:
#   hf download InternScience/Agents-A1-FP8-dynamic --local-dir /home/pawl/models/Agents-A1-FP8-dynamic

# --- Sampling: the model card's recommended values -------------------------------------
# InternScience recommends temp 0.85, top_p 0.95, top_k 20, min_p 0.0, presence_penalty 1.1,
# repetition_penalty 1.0. These map to the compose's --override-generation-config, EXCEPT
# presence_penalty (see the limitation note below).
TEMP=0.85
TOP_P=0.95
TOP_K=20
MIN_P=0.0
REPEAT_PENALTY=1.0

# --- TWO limitations you can't fix from this .env (the compose is GENERATED, "never hand-
#     repaired" per its header) ---------------------------------------------------------
#  1. presence_penalty=1.1 (card-recommended) is NOT in the compose's generation-config JSON,
#     so there's no env knob for it. Adding it means regenerating the compose via
#     scripts/generate-compose.sh (the sanctioned path), not editing fp8.yml by hand.
#  2. The compose HARDCODES --default-chat-template-kwargs '{"enable_thinking": false}' — but
#     Agents-A1's whole edge is agentic thinking-ON (its own caveats: 8-pack ON 110 vs OFF 105,
#     cli-40 23/40 ON). So as shipped it runs in its WEAKER mode. Turning thinking ON needs
#     either a compose regen or a per-request client override (chat_template_kwargs.enable_thinking
#     =true, e.g. a LiteLLM pre-call hook like the omni one) — NOT settable here.
#     Caveat to know: the hermes-20 pack REGRESSES with thinking ON (12→9), even though
#     everything else improves. So thinking-ON is right for CLI/agentic, mixed for hermes-style.

# --- Rig note ---------------------------------------------------------------------------
# This is vLLM TP=2 → it does cross-GPU all-reduce every layer, which your PCIe-4.0-x4 GPU1
# throttles (see [[rig-pcie-x4-bottleneck]]: TP=2 decode ~85 vs ref ~154 tok/s). The llama.cpp
# layer-split models (Deckard/hauhau) avoid this; Agents-A1 will feel notably slower here than
# its benchmarks. GPU0 also carries the ~1.7 GB desktop — 0.92 util is the tested default.
# GPU_MEMORY_UTILIZATION=0.92
# MAX_MODEL_LEN=262144

# Matches the litellm route (agents-a1 → :8072) + Hermes provider entry.
PORT=8072
