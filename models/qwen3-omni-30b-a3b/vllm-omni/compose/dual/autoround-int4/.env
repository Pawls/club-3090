# Machine-local overrides (untracked; docker compose auto-loads this because
# switch.sh/launch.sh — or a direct `docker compose up` from this dir — cd here first).

# Weights live here on this host (repo-root models-cache doesn't exist — same as the
# 35B .env). Omni int4-autoround downloads to $MODEL_DIR/$MODEL_SUBDIR:
#   hf download Intel/Qwen3-Omni-30B-A3B-Instruct-int4-AutoRound \
#     --local-dir /home/pawl/models/qwen3-omni-30b-a3b-instruct-int4-autoround
MODEL_DIR=/home/pawl/models

# Serve on 8042 (matches the Hermes provider vllm-omni-qwen3-omni-30b → :8042).
PORT=8042
