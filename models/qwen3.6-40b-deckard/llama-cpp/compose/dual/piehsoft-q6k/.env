# Machine-local overrides for Qwen3.6-40B-Deckard (dense 40B uncensored, Q6_K MTP GGUF).
# llama.cpp, DUAL-card layer-split — the 31 GB Q6_K cannot fit one 24 GB card, so this
# uses BOTH 3090s (GPU-mutex: apex / omni / 35b-a3b must be DOWN first).

MODEL_DIR=/home/pawl/models

# Both cards required. Device 0 = the desktop card (GPU0, ~1.7 GB always busy driving the
# Windows monitors); device 1 = the headless card (GPU1, fully free).
CUDA_VISIBLE_DEVICES=0,1

# --- Rig-specific fit (the important bit) ------------------------------------------------
# @131072 the model needs ~44 GB total across the two cards (~22 GB/card on an even 1,1
# split). On THIS box GPU0 only has ~22.3 GB free (the desktop eats ~1.7 GB), so an even
# split leaves GPU0 with almost no headroom and a browser/VS Code spike can OOM it.
# MEASURED 2026-07-10: 0.9,1.0 over-corrected — it stacked GPU1 to 23.2 GB (1.0 GB free,
# OOM-risk under prefill) while GPU0 sat at 20.1 GB (4.3 GB free). GPU1 also carries the MTP
# draft context, so it needs MORE headroom, not less. 1.1,1.0 shifts ~2 GB back onto the
# desktop card (which has room) → ~GPU0 22 GB (2.6 free) / GPU1 21.3 GB (3.2 free), balanced.
#   If GPU0 OOMs on a desktop spike → 1.0,1.0; if GPU1 OOMs → 1.2,1.0. Verify in the load log.
TENSOR_SPLIT=1.1,1.0

# Full tested context (q8_0 KV). 192K OOMs on the dual split; 131072 is the validated max.
# If the desktop-shared GPU0 makes 131072 unstable, step down: 114688 (112K) or 98304 (96K)
# buy ~1.5–3 GB of per-card headroom. (Keep Hermes' deckard-40b context_length in sync with
# whatever you set here, or Hermes will send prompts the server silently truncates.)
CTX_SIZE=131072
KV_TYPE=q8_0
# More context than 131072 would need q4_0 KV (halves the KV cache) — UNTESTED on this build
# per the compose header; only try KV_TYPE=q4_0 if you deliberately want to push past 128K.

# NP=1 is mandatory here (compose warns: extra slots divide throughput + OOM the spec buffer).
NP=1

# MTP ON, n=2 — unlike apex's MoE (where MTP lost), Deckard is DENSE and MTP is a big WIN:
# off 22.7 → n=2 ~36 narrative / ~46 code tok/s (+59% / +104%), draft acceptance 76–80%.
MTP_DRAFT_N_MAX=2

# --- Thinking / reasoning (Deckard IS a thinking model — it natively emits <think>) -------
# REASONING=on turns the thinking gate ON to use Deckard's full reasoning capability.
#   REASONING_FORMAT=deepseek parses the <think> block into the response's reasoning_content
#   field (clean separation) — LiteLLM passes it through. To actually SEE the reasoning in
#   Hermes, also set display.show_reasoning: true (it's false now, so it'd think but hide it).
# Set REASONING=off for snappy non-thinking replies (faster, fewer tokens).
#
# 2026-08-07: flipped on → off to match the upstream compose default (`${REASONING:-off}`
# in mtp.yml/vision.yml). Deckard IS a thinking model, but upstream ships it thinking-OFF
# and its own header Quality line — "core 8-pack 105/150 (70%) think-off" — was measured
# in that mode, so ON was an unmeasured local deviation. Flip back to `on` per-session if
# you want the <think> blocks; this is a request-shaping flag, costs no VRAM either way.
REASONING=off
REASONING_FORMAT=deepseek
# PRESERVE_THINKING — IS supported here (corrected 2026-07-10): llama.cpp b9570 has
# --chat-template-kwargs (LLAMA_ARG_CHAT_TEMPLATE_KWARGS), the compose now wires it, and
# Deckard's embedded template implements the preserve_thinking variable (verified via /props).
#   true  = keep prior turns' <think> blocks in multi-turn context (matches your vLLM 27b/35b
#           .envs, which also set true) — better multi-turn reasoning continuity.
#   false = strip old thinking, keep only the current turn (context-economical).
# NOTE: Deckard is 131K (vs the vLLM models' 262K), so preserved thinking eats the window
# faster — if long coding sessions run out of context, flip this to false.
# 2026-08-07: set to false to match the upstream compose default (`${PRESERVE_THINKING:-false}`).
# No-op while REASONING=off — preserve only applies when thinking is on.
PRESERVE_THINKING=false

# Anti-loop sampling — compose defaults (good for a 40B merge). DRY is opt-in for severe
# long-context loops only (it can over-suppress legit repetition in code).
# REPEAT_PENALTY=1.1
# REPEAT_LAST_N=256
# DRY_MULTIPLIER=0.8   # only if you hit repetition loops near max context

# Matches the litellm route (deckard-40b → host.docker.internal:8199) + Hermes provider.
PORT=8199
