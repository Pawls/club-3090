# Machine-local overrides for the Muse-Glimmer-30B single-card DFlash+vision lane.
# MUST live in THIS directory, not at <engine>/compose/ — docker compose only
# auto-loads a .env from the directory it is invoked from, and serve.sh/switch.sh cd
# into the compose's own dir. A parent-level .env is silently never read (AGENTS.md).
#
# See dflash-vision.yml's header for the full rationale + first-boot checklist.

MODEL_DIR=/home/pawl/models

# Pin to GPU1 (headless); leave GPU0 for the Windows desktop / ComfyUI. The x4 slot
# only slows the one-time weight load — irrelevant to single-GPU inference.
CUDA_VISIBLE_DEVICES=1

# 131072 = the model's native window. Cheap here: GQA 16:1 + [L,L,L,G] SWA means
# only 13 of 52 layers hold full-length KV, so this is under 1 GiB at q8_0.
CTX_SIZE=131072

# q8_0/q8_0. f16 costs only ~+0.75 GiB on this arch if you want max fidelity for
# agentic runs — flip both to f16 and re-check nvidia-smi headroom.
KV_TYPE_K=q8_0
KV_TYPE_V=q8_0

# Larger microbatch speeds prefill/TTFT on image tokens (up to 4096 visual tokens
# per image) + long text.
UBATCH_SIZE=1024

# Effort lever for THIS model — a chat-template kwarg, NOT --reasoning (there are no
# <think> tags; reasoning rides an `assistant to=self` channel). Meta advises
# high/xhigh for coding + agentic work. Override per boot:
#   REASONING_STRENGTH=xhigh ./serve.sh muse
REASONING_STRENGTH=high

# Block size is 16 = 1 anchor + 15 proposals; upstream clamps anything above 15.
# ⚠ BOOT-TIME ONLY on this build — the per-request "speculative":{"n_max":N} field is
# silently ignored (verified: identical draft_n across N=0..15), so spec-sweep.sh's
# no-reboot fast path cannot sweep this drafter. Changing depth = reboot.
DFLASH_N_MAX=15

# Drafter switch, for A/B-ing DFlash without editing the compose:
#   draft-dflash = ON (default)   ·   none = OFF
# `none` skips LOADING the draft model entirely, so the OFF arm is 2.51 GiB lighter —
# it is a "what would I actually run" comparison, not a memory-matched one.
#   SPEC_TYPE=none ./serve.sh muse
SPEC_TYPE=draft-dflash

# LOCALLY BUILT image — no upstream one exists for this model yet. Muse Glimmer is
# commit 62bf73d (PR #26841), merged to master 2026-08-10; as of that day the newest
# RELEASE (b10344) was 5 commits behind it and the newest GHCR CUDA image (b10335,
# == the rolling :server-cuda tag) 14 behind. Built from master 030ebb5 with
# .devops/cuda.Dockerfile --target server, CUDA_DOCKER_ARCH=86 → 3090 ONLY.
# Swap to an official tag the moment one contains the commit:
#   git merge-base --is-ancestor 62bf73d25c53b8161f8a22894d4f90c4aebbd7d0 <tag>
LLAMACPP_IMAGE=club3090/llama.cpp:server-cuda-master-030ebb5-sm86

# Distinct name + port so it coexists with every other lane in Hermes/LiteLLM
# (only one runs at a time under the GPU mutex, but all stay selectable).
SERVED_NAME=muse-glimmer-30b
PORT=8210
