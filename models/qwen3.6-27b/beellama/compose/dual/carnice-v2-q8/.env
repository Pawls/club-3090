# Weights live here on this host (repo-root models-cache doesn't exist).
MODEL_DIR=/home/pawl/models

# Thinking ON — testing whether reasoning improves agentic comprehension vs the 27b.
# (2026-07-10: was ENABLE_THINKING=true, a DEAD variable — this compose reads
# ${REASONING}, whose default is already `on`. Renamed so the file says what it
# means; effective behavior unchanged. REASONING=off to disable.)
REASONING=on

# Keep the <think> reasoning from ALL prior assistant turns in context (Qwen's
# preserve_thinking template kwarg). NOW LIVE (2026-07-10): beellama supports
# --chat-template-kwargs and the compose finally wires it — previously this was a
# DEAD no-op (the compose never referenced the var). Verify the embedded template
# honors it on first boot: curl :8070/props | grep preserve_thinking.
PRESERVE_THINKING=true

# WSL2 host-RAM: add --no-mmap so the ~29GB Q8 GGUF loads straight to VRAM instead
# of being mmap'd into the WSL2 VM's page cache (which would otherwise sit resident
# and compete with Windows / Android Studio / WSL2 training). Opt-in only — the
# compose default is canonical mmap. Any non-empty value enables (false enables too).
NO_MMAP=true