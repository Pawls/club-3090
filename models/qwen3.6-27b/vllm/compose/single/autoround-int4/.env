# WSL2 boot-crash workaround — see PR #84 + issue #60, and CLAUDE.md "Compose layout".
# vLLM + WSL2 + recent drivers hit `gptq_marlin_repack` cudaErrorNotReady on boot
# with the default `expandable_segments:True`. This override fixes it.
# Must live in THIS directory: docker compose auto-loads .env only from the dir it
# is invoked in, and switch.sh/launch.sh cd here before `docker compose up`. A copy
# one level up (compose/.env) is silently ignored.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False,max_split_size_mb:512
# Single card, well-cooled x16 GPU0 with nothing else on it. Measured free VRAM at
# startup on this WSL2 rig is ~22.76 GiB, so 0.95 (needs 22.8) just overflows — 0.94
# (needs 22.56) is the safe ceiling with margin. The KV pool is razor-thin with MTP
# on, so we run as high as the free memory allows. The dual compose stays at 0.92
# (two cards + TP coordination need more headroom).
GPU_MEMORY_UTILIZATION=0.94
